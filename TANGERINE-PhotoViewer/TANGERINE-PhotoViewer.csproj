<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>1.2.0</Version>
    <RootNamespace>TANGERINE_PhotoViewer</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\TANGERINE-PV.ico</ApplicationIcon>
    <NeutralLanguage>en-US</NeutralLanguage>
    <SatelliteResourceLanguages>en-US;zh-CN;zh-TW;zh-HK;zh-MO</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WPF's per-monitor layout and rendering active when a window crosses displays. -->
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.DoNotScaleForDpiChanges" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.17.2" />
    <PackageReference Include="NetVips" Version="3.0.0" />
    <PackageReference Include="NetVips.Native.win-x64" Version="8.18.6" />
  </ItemGroup>



  <ItemGroup><EmbeddedResource Include="DefaultApps\Native\TzipLatestHash.dll" LogicalName="TANGERINE_PhotoViewer.TzipLatestHash.dll" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets\TPV_Photo.ico" LogicalName="TANGERINE_PhotoViewer.TPV_Photo.ico" /></ItemGroup>
  <ItemGroup><Resource Include="Assets\TANGERINE-PV.png" /></ItemGroup>
</Project>
