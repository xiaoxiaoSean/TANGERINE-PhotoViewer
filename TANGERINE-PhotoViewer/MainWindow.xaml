<Window x:Class="TANGERINE_PhotoViewer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework" Icon="Assets/TANGERINE-PV.png" Background="Black" Foreground="White" Width="1000" Height="700" MinWidth="500" MinHeight="350" Loaded="Window_Loaded" KeyDown="Window_KeyDown" KeyUp="Window_KeyUp" Deactivated="Window_Deactivated" AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop">
  <Window.Resources>
    <Style TargetType="Slider"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="Black"/></Style>
    <Style TargetType="Menu"><Setter Property="Background" Value="Black"/><Setter Property="Foreground" Value="White"/></Style>
    <Style TargetType="MenuItem"><Setter Property="Background" Value="Black"/><Setter Property="Foreground" Value="White"/></Style>
  </Window.Resources>
  <DockPanel Background="Black">
    <Menu DockPanel.Dock="Top">
      <MenuItem x:Name="OpenItem" Click="Open_Click"/>
      <MenuItem x:Name="ZoomInItem" Click="ZoomIn_Click" Visibility="Collapsed"/>
      <MenuItem x:Name="ZoomOutItem" Click="ZoomOut_Click" Visibility="Collapsed"/>
      <MenuItem x:Name="RotateLeftItem" Click="RotateLeft_Click" Visibility="Collapsed"/>
      <MenuItem x:Name="RotateRightItem" Click="RotateRight_Click" Visibility="Collapsed"/>
      <MenuItem x:Name="GifItem" Click="Gif_Click" Visibility="Collapsed"/>
      <MenuItem x:Name="DetailsItem" Click="Details_Click" Visibility="Collapsed"/>
      <MenuItem x:Name="UnloadItem" Click="Unload_Click" Visibility="Collapsed"/>
      <MenuItem x:Name="StopItem" Click="Stop_Click" Visibility="Collapsed"/>
      <MenuItem x:Name="SystemItem" Click="System_Click"/>
      <MenuItem x:Name="AboutItem" Click="About_Click"/>
    </Menu>
    <Grid DockPanel.Dock="Bottom" Background="Black">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <Label x:Name="ZoomLabel" Background="Black" Foreground="White" Visibility="Collapsed"/>
        <Label x:Name="NavigatorLimitLabel" Background="Black" Foreground="White" Visibility="Collapsed"/>
      </StackPanel>
      <Label x:Name="StatusLabel" Grid.Column="1" Background="Black" Foreground="White"/>
      <Slider x:Name="ZoomSlider" Grid.Column="2" Width="200" Margin="12,0" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" Visibility="Collapsed" VerticalAlignment="Center" ValueChanged="ZoomSlider_ValueChanged" MouseMove="ZoomSlider_MouseMove"/>
    </Grid>
    <Grid x:Name="PreviewArea" Background="Black" SizeChanged="PreviewArea_SizeChanged">
      <Image x:Name="EmptyLogo" Source="Assets/TANGERINE-PV.png" Stretch="Uniform" MaxWidth="320" MaxHeight="320" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
      <ScrollViewer x:Name="Viewer" Background="Transparent" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="Viewer_SizeChanged" PreviewMouseWheel="Viewer_PreviewMouseWheel" PreviewMouseDown="Viewer_PreviewMouseDown" PreviewMouseMove="Viewer_PreviewMouseMove" PreviewMouseUp="Viewer_PreviewMouseUp" ScrollChanged="Viewer_ScrollChanged">
        <Canvas x:Name="Surface" Background="Transparent"><Image x:Name="Preview" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/><Image x:Name="Photo" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/></Canvas>
      </ScrollViewer>
      <Border x:Name="Navigator" Background="Black" BorderBrush="White" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,0" Visibility="Collapsed" PreviewMouseWheel="Navigator_PreviewMouseWheel">
        <Grid>
          <Canvas x:Name="NavigatorCanvas" Background="Black" MouseLeftButtonDown="Navigator_MouseLeftButtonDown" MouseMove="Navigator_MouseMove" MouseLeftButtonUp="Navigator_MouseLeftButtonUp">
            <Image x:Name="NavigatorImage" Stretch="Fill" IsHitTestVisible="False"/>
            <Border x:Name="NavigatorViewport" BorderBrush="White" BorderThickness="2" Background="#33444444" IsHitTestVisible="False"/>
          </Canvas>
          <primitives:Thumb x:Name="NavigatorResize" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Background="White" DragDelta="NavigatorResize_DragDelta"/>
        </Grid>
      </Border>
      <Canvas x:Name="NavigationOverlay">
        <Button x:Name="PreviousImageButton" Click="PreviousImage_Click" Visibility="Collapsed" Background="Black" Foreground="White" BorderBrush="White" BorderThickness="1" FontSize="24"/>
        <Button x:Name="NextImageButton" Click="NextImage_Click" Visibility="Collapsed" Background="Black" Foreground="White" BorderBrush="White" BorderThickness="1" FontSize="24"/>
      </Canvas>
    </Grid>
  </DockPanel>
</Window>
